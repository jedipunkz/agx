---
import '../styles/theme.css';
import { REPO_URL, site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(`${base}og.png`, Astro.site).toString();
const screenshotURL = new URL(`${base}${site.screenshot}`, Astro.site).toString();
const ogImageAlt = 'agx terminal dashboard managing multiple AI coding agents across parallel git worktrees';
const keywords =
  'agx, AI coding agent, AI agent orchestrator, Claude Code, Codex CLI, Gemini CLI, OpenCode, parallel agents, git worktree, terminal dashboard, CLI, developer tools, agent manager, coding agents';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalURL}#software`,
      name: 'agx',
      description,
      url: canonicalURL,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'CLI',
      operatingSystem: 'macOS, Linux',
      image: ogImageURL,
      screenshot: screenshotURL,
      downloadUrl: `${REPO_URL}/releases`,
      softwareHelp: REPO_URL,
      codeRepository: REPO_URL,
      keywords,
      featureList: [
        'Run Claude Code, Codex CLI, Gemini CLI, and OpenCode agents from one workflow',
        'Isolated git worktree and branch per agent session',
        'Terminal dashboard to monitor running, waiting, successful, failed, and killed agents',
        'Resume sessions, stream logs, and send input when an agent is waiting',
        'Automatic cleanup of finished worktrees',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': `${canonicalURL}#person` },
      publisher: { '@id': `${canonicalURL}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL}#website`,
      name: 'agx',
      url: canonicalURL,
      description,
      inLanguage: 'en',
      publisher: { '@id': `${canonicalURL}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalURL}#person`,
      name: 'jedipunkz',
      url: 'https://github.com/jedipunkz',
      sameAs: ['https://github.com/jedipunkz'],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="jedipunkz" />
    <meta name="application-name" content="agx" />
    <meta name="apple-mobile-web-app-title" content="agx" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://jedipunkz.rocks" crossorigin />
    <meta property="og:site_name" content="agx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: var(--space-3);
    z-index: 300;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--solid);
    color: var(--solid-fg);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .skip-link:focus {
    left: var(--space-3);
    color: var(--solid-fg);
  }
</style>

<script>
  // One delegated handler covers every [data-copy] control on the page.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLElement>('[data-copy]');
    if (!button) return;

    const text = button.dataset.copy;
    if (!text) return;

    // navigator.clipboard is undefined in insecure contexts, so this has to be
    // checked before the call rather than caught after it.
    const clipboard = navigator.clipboard;
    if (!clipboard || typeof clipboard.writeText !== 'function') return;

    clipboard
      .writeText(text)
      .then(() => {
        const original = button.textContent;
        button.textContent = 'Copied';
        button.dataset.copied = 'true';

        window.setTimeout(() => {
          button.textContent = original;
          delete button.dataset.copied;
        }, 1600);
      })
      .catch(() => {
        /* write denied by the user or the permissions policy */
      });
  });
</script>
