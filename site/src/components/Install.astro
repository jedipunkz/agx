---
import CommandLine from './CommandLine.astro';
import { INSTALL_COMMAND, REPO_URL } from '../data/site';
---

<section id="install" class="install">
  <div class="container">
    <p class="eyebrow">Install</p>
    <h2>One command, then run it in any repository.</h2>
    <p class="lede">Homebrew on macOS and Linux. agx is MIT licensed and builds from source with Go.</p>

    <CommandLine cmd={INSTALL_COMMAND} variant="panel" label="Copy the install command" />

    <p class="alt">
      Prefer a binary? Grab one from <a href={`${REPO_URL}/releases`} target="_blank" rel="noopener">Releases</a>,
      or read the <a href={`${REPO_URL}/blob/main/README.md`} target="_blank" rel="noopener">documentation</a>.
    </p>
  </div>
</section>

<style>
  .install {
    padding: var(--space-9) 0 var(--space-10);
    border-top: 1px solid var(--line);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }

  h2 {
    max-width: 30rem;
    color: var(--fg);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    text-wrap: balance;
  }

  .lede {
    max-width: 34rem;
    margin: var(--space-4) 0 var(--space-6);
    color: var(--fg-secondary);
    font-size: var(--text-lede);
  }

  .alt {
    margin-top: var(--space-5);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .alt a {
    color: var(--fg-secondary);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .alt a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  @media (max-width: 760px) {
    .install {
      padding: var(--space-8) 0;
    }
  }
</style>
