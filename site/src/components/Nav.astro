---
import { REPO_URL, navLinks, site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <div class="nav-inner">
    <a href={base} class="brand" aria-label={`${site.name} — home`}>
      <img src={`${base}icon.png`} alt="" width="26" height="26" class="brand-mark" />
      <span class="brand-name">{site.name}</span>
      <span class="brand-tag">{site.tagline}</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a href={REPO_URL} class="nav-repo" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: rgb(17 17 16 / 78%);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(120%) blur(14px);
    -webkit-backdrop-filter: saturate(120%) blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--container);
    height: 64px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-right: auto;
    min-width: 0;
  }

  .brand-mark {
    align-self: center;
    border-radius: var(--radius-sm);
    /* The project mark is the one colored asset; hold it to the monochrome scale. */
    filter: grayscale(1) contrast(1.05);
    opacity: 0.92;
  }

  .brand-name {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .brand-tag {
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-links a {
    color: var(--fg-secondary);
    font-size: var(--text-sm);
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .nav-repo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 32px;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--fg-secondary);
    font-size: var(--text-sm);
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
  }

  .nav-repo:hover {
    color: var(--fg);
    border-color: var(--line-strong);
    background: var(--bg-elevated);
  }

  @media (max-width: 860px) {
    .nav-links,
    .brand-tag {
      display: none;
    }
  }
</style>
