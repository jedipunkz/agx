---
import CommandLine from './CommandLine.astro';
import { INSTALL_COMMAND, REPO_URL, site } from '../data/site';
---

<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">
      <span class="wordmark">agx</span>
      <span class="sep" aria-hidden="true">/</span>
      <span>agent cross</span>
    </p>

    <h1>Run coding agents in parallel, one git worktree each.</h1>

    <p class="lede">
      agx starts Claude Code, Codex CLI, Gemini CLI, and OpenCode in isolated worktrees, then
      gives you a single terminal dashboard to monitor, resume, inspect, and clean up every session.
    </p>

    <div class="actions">
      <a href="#install" class="btn btn-primary">Install agx</a>
      <a href={REPO_URL} class="btn btn-ghost" target="_blank" rel="noopener">View source</a>
    </div>

    <CommandLine cmd={INSTALL_COMMAND} label="Copy the install command" />

    <ul class="meta">
      <li>Homebrew</li>
      <li>macOS &amp; Linux</li>
      <li>MIT licensed</li>
    </ul>
  </div>

  <figure class="shot">
    <div class="shot-frame">
      <div class="shot-bar">
        <span class="shot-title">agx dash</span>
      </div>
      <button type="button" class="shot-trigger" aria-label="Enlarge the dashboard screenshot">
        <img
          src={site.screenshot}
          alt="agx terminal dashboard listing agent sessions with status, repository, and worktree"
          width="2988"
          height="1642"
          loading="eager"
          decoding="async"
        />
      </button>
    </div>
  </figure>
</section>

<div class="lightbox" id="hero-lightbox" role="dialog" aria-modal="true" aria-label="Enlarged dashboard screenshot" hidden>
  <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
  <img src={site.screenshot} alt="agx terminal dashboard listing agent sessions" decoding="async" />
</div>

<style>
  .hero {
    max-width: var(--container);
    margin: 0 auto;
    padding: calc(64px + var(--space-9)) var(--gutter) var(--space-9);
  }

  .hero-inner {
    max-width: 46rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }

  .wordmark {
    color: var(--fg-secondary);
    font-weight: 600;
  }

  .sep {
    color: var(--decor);
  }

  h1 {
    color: var(--fg);
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .lede {
    max-width: 38rem;
    margin-top: var(--space-5);
    color: var(--fg-secondary);
    font-size: var(--text-lede);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-5);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background 0.18s var(--ease), border-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .btn-primary {
    background: var(--solid);
    color: var(--solid-fg);
  }

  .btn-primary:hover {
    background: var(--solid-hover);
    color: var(--solid-fg);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--fg-secondary);
  }

  .btn-ghost:hover {
    border-color: var(--line-strong);
    background: var(--bg-elevated);
    color: var(--fg);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-5);
    list-style: none;
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }

  .meta li + li {
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
  }

  .shot {
    margin-top: var(--space-9);
  }

  .shot-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    box-shadow: var(--shadow);
  }

  .shot-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .shot-title {
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
  }

  .shot-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .shot-trigger:focus-visible {
    outline-offset: -2px;
  }

  .shot-trigger img {
    display: block;
    width: 100%;
    height: auto;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgb(17 17 16 / 92%);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: min(1400px, 96vw);
    max-height: 92vh;
    width: auto;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .lightbox-close {
    position: absolute;
    top: max(16px, 2vmin);
    right: max(16px, 2vmin);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--fg-secondary);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }

  .lightbox-close:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .hero {
      padding: calc(64px + var(--space-7)) var(--gutter) var(--space-7);
    }

    .shot {
      margin-top: var(--space-7);
    }
  }
</style>

<script>
  const lightbox = document.getElementById('hero-lightbox');
  const trigger = document.querySelector('.shot-trigger');
  const closeBtn = lightbox?.querySelector('.lightbox-close');

  const open = () => {
    if (!lightbox) return;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    if (closeBtn instanceof HTMLElement) closeBtn.focus();
  };

  const close = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    if (trigger instanceof HTMLElement) trigger.focus();
  };

  // The dialog's only focusable child is the close button, so trapping focus
  // means keeping it there: aria-modal alone does not stop Tab reaching the
  // page behind the overlay.
  const keepFocus = () => {
    if (closeBtn instanceof HTMLElement) closeBtn.focus();
  };

  trigger?.addEventListener('click', open);
  lightbox?.addEventListener('click', close);

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return;

    if (event.key === 'Escape') {
      close();
      return;
    }

    if (event.key === 'Tab') {
      event.preventDefault();
      keepFocus();
    }
  });

  document.addEventListener('focusin', (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.target instanceof Node && lightbox.contains(event.target)) return;
    keepFocus();
  });
</script>
