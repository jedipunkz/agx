---
import Section from './Section.astro';
import { features } from '../data/site';
---

<Section
  id="features"
  label="Features"
  title="Built for keeping many agents straight."
  lede="Each session is isolated by git, observable from one place, and cleaned up on its own."
>
  <div class="grid">
    {features.map((feature, index) => (
      <article class:list={['card', feature.wide && 'card-wide']}>
        <header>
          <span class="index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="label">{feature.label}</span>
        </header>
        <h3>{feature.title}</h3>
        <p>{feature.desc}</p>
      </article>
    ))}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--bg);
    transition: background 0.18s var(--ease);
  }

  .card:hover {
    background: var(--bg-subtle);
  }

  .card-wide {
    grid-column: span 3;
    background: var(--bg-subtle);
  }

  .card-wide:hover {
    background: var(--bg-elevated);
  }

  .card-wide h3 {
    max-width: 30rem;
    font-size: 1.375rem;
  }

  .card-wide p {
    max-width: 42rem;
  }

  header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
  }

  .index {
    color: var(--decor);
  }

  .label {
    color: var(--fg-secondary);
  }

  h3 {
    color: var(--fg);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.3;
  }

  p {
    color: var(--fg-secondary);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card-wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .card-wide {
      grid-column: span 1;
    }

    .card {
      padding: var(--space-5);
    }
  }
</style>
